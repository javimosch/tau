{"ok":true,"status":"would_install","shells":[{"shell":"zsh","rc":"<HOME>/.zshrc","rc_status":"would_append","status":"would_install","path":"<HOME>/.zsh/completions/_tau","files":[{"path":"<HOME>/.zsh/completions/_tau","action":"create","diff":"--- /dev/null\n+++ b/<HOME>/.zsh/completions/_tau\n@@ -0,0 +1,395 @@\n+#compdef tau\n+# zsh completion for tau\n+# -----------------------------------------------------------------------------\n+# One-time (current session):\n+#   source completions/_tau\n+#\n+# Permanent:\n+#   1. Pick (or create) a completions directory in your $fpath, e.g.:\n+#        mkdir -p ~/.zsh/completions\n+#   2. Add it to $fpath BEFORE the `compinit` call in ~/.zshrc:\n+#        fpath=(~/.zsh/completions $fpath)\n+#   3. Copy this file (the name _tau is required):\n+#        cp completions/_tau ~/.zsh/completions/_tau\n+#   4. Rebuild the completion cache:\n+#        rm -f ~/.zcompdump && compinit\n+\n+_tau() {\n+    local curcontext=\"$curcontext\" state line\n+    typeset -A opt_args\n+\n+    local -a global_opts=(\n+        '(-h --help)'{-h,--help}'[show help text]'\n+        '(-v --version)'{-v,--version}'[show version]'\n+        '--help-json[output machine-readable help as JSON]'\n+        '(-p --print)'{-p,--print}'[non-interactive (print-only) mode]'\n+        '--mode=[output mode]:mode:(text json)'\n+        '--stream[enable streaming output]'\n+        '--no-stream[disable streaming output]'\n+        '--debug[show perf stats and tool calls; write redacted log to ~/.config/tau/debug/]'\n+        '--dry-run[report tool calls without executing them]'\n+        '--provider=[LLM provider]:provider:(xiaomi openai deepseek opencode-go)'\n+        '--model=[model ID or provider/model shorthand]:model:'\n+        '--api-key=[API key (overrides env vars)]:key:'\n+        '--system-prompt=[set (replace) system prompt]:prompt:'\n+        '--append-system-prompt=[append to system prompt (repeatable)]:prompt:'\n+        '(-t --tools)'{-t,--tools}'=[allowlist of tool names, comma-separated]:tools:(bash ls read write edit grep find calculator)'\n+        '(-xt --exclude-tools)'{-xt,--exclude-tools}'=[denylist of tool names, comma-separated]:tools:(bash ls read write edit grep find calculator)'\n+        '(-nt --no-tools)'{-nt,--no-tools}'[disable all built-in tools]'\n+        '--temperature=[sampling temperature (0.0–2.0)]:float:'\n+        '--max-tokens=[maximum output tokens]:n:'\n+        '--timeout-ms=[HTTP request timeout in ms (default 120000)]:ms:'\n+        '--thinking[enable reasoning/thinking chunks]'\n+        '--context-window=[override model context window in tokens]:tokens:'\n+        '--no-compact[disable automatic context compaction]'\n+        '--compact-threshold=[compaction trigger fraction of context (0–1)]:float:'\n+        '--compact-keep-recent=[tokens of recent history kept verbatim after compaction]:tokens:'\n+        '--schema=[JSON Schema for structured output (inline JSON or @file)]:schema:_files'\n+        '--session=[named session for conversation persistence]:name:'\n+        '--goal-max-iterations=[per-run loop cap for /goal mode]:n:'\n+        '--max-iterations=[tool-loop runaway backstop]:n:'\n+        '--role=[role for adversarial author↔critic loop]:role:(author critic coordinator none)'\n+        '--scan-agents[scan cwd for AGENTS.md files]'\n+        '--load-agents-md=[load an AGENTS.md file into system context]:file:_files'\n+        '--auto-agents-md[auto-load cwd/AGENTS.md on startup]'\n+    )\n+\n+    _arguments -C \\\n+        $global_opts \\\n+        ': :->command' \\\n+        '*:: :->command_args'\n+\n+    case $state in\n+        command)\n+            local -a commands=(\n+                'acp:manage the Agent Client Protocol server (start|stop|status|serve)'\n+                'models:list available providers and models'\n+                'skills:manage skills autodiscovery (list|search|load)'\n+                'fleet:multi-agent orchestration (run|status|list|logs|cancel)'\n+                'init:write a commented starter config (~/.config/tau/config.json)'\n+                'config:inspect, validate, or edit the config (show|validate|set|get|unset|edit|schema)'\n+                'setup:one-shot onboarding (init + completions + doctor)'\n+                'completions:install generated shell completions (install)'\n+                'doctor:validate setup (config, provider, key, connectivity)'\n+                'bug:file a pre-filled GitHub issue with doctor diagnostics'\n+                'guide:print the embedded operator manual'\n+                'version:print version (--verbose adds build metadata)'\n+                'upgrade:self-update in place via the verified install.sh'\n+                'explain:offline error-catalog lookup (cause + remediation)'\n+            )\n+            _alternative \\\n+                'commands:subcommand:_describe subcommand commands' \\\n+                'files:file path (for @file inclusion):_files'\n+            ;;\n+\n+        command_args)\n+            case ${line[1]} in\n+                acp)\n+                    _arguments \\\n+                        '1: :(start stop status serve)' \\\n+                        '--acp-socket=[Unix socket path for ACP daemon]:path:_files' \\\n+                        '--max-iterations=[runaway-loop backstop]:n:'\n+                    ;;\n+\n+                fleet)\n+                    local curcontext=\"$curcontext\" state line\n+                    local -a fleet_flags=(\n+                        '--goal=[fleet objective (natural language)]:text:'\n+                        '--id=[fleet identifier]:id:'\n+                        '--provider=[LLM provider]:provider:(xiaomi openai deepseek opencode-go)'\n+                        '--model=[model ID]:model:'\n+                        '--api-key=[API key]:key:'\n+                        '--coordinator-model=[coordinator agent model override]:model:'\n+                        '--worker-model=[worker agent model override]:model:'\n+                        '--sequential[run worker agents sequentially]'\n+                        '--parallel[run worker agents in parallel (default)]'\n+                        '--items=[pre-supplied work items, skips coordinator (JSON)]:json:'\n+                        '--schema=[JSON Schema for work-item breakdown]:schema:_files'\n+                    )\n+                    _arguments -C \\\n+                        '1: :->fleet_sub' \\\n+                        '*:: :->fleet_opts'\n+                    case $state in\n+                        fleet_sub)\n+                            local -a fleet_cmds=(\n+                                'run:decompose a goal and dispatch to parallel worker agents'\n+                                'status:check status of a fleet by ID'\n+                                'list:list all known fleets'\n+                                'logs:stream worker session logs for a fleet ID'\n+                                'cancel:cancel a running fleet by ID'\n+                            )\n+                            # Flags are valid before the sub-subcommand too.\n+                            _arguments '1: :_describe \"fleet subcommand\" fleet_cmds' $fleet_flags\n+                            ;;\n+                        fleet_opts)\n+                            _arguments $fleet_flags\n+                            ;;\n+                    esac\n+                    ;;\n+\n+                skills)\n+                    local -a skill_cmds=(\n+                        'list:list all discoverable skills'\n+                        'search:search skills by keyword'\n+                        'load:load a skill into the system context by name'\n+                    )\n+                    _arguments '1: :_describe skill_subcommand skill_cmds'\n+                    ;;\n+\n+                config)\n+                    local curcontext=\"$curcontext\" state line\n+                    _arguments -C \\\n+                        '1: :->config_sub' \\\n+                        '*:: :->config_opts'\n+                    case $state in\n+                        config_sub)\n+                            local -a config_cmds=(\n+                                'show:print the resolved effective config (keys redacted)'\n+                                'validate:check a config file (CI/pre-commit)'\n+                                'set:set a config key to a value'\n+                                'get:print a config key value (secrets redacted)'\n+                                'unset:remove a config key'\n+                                'edit:open the config in $EDITOR (validates on save)'\n+                                'schema:print the config file JSON Schema (draft 2020-12)'\n+                            )\n+                            _describe 'config subcommand' config_cmds\n+                            ;;\n+                        config_opts)\n+                            # $line[1] is the config subcommand just typed.\n+                            case ${line[1]} in\n+                                validate)\n+                                    _arguments \\\n+                                        '--json[emit the stable JSON report (schema-pinned)]' \\\n+                                        '--mode=[report format]:mode:(text json)' \\\n+                                        '*:config file:_files -g \"*.json\"'\n+                                    ;;\n+                                set)\n+                                    _arguments \\\n+                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \\\n+                                        '2:value:' \\\n+                                        '--mode=[output format]:mode:(text json)' \\\n+                                        '*:config file:_files -g \"*.json\"'\n+                                    ;;\n+                                get)\n+                                    _arguments \\\n+                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \\\n+                                        '--raw[print secret values unredacted]' \\\n+                                        '--mode=[output format]:mode:(text json)' \\\n+                                        '*:config file:_files -g \"*.json\"'\n+                                    ;;\n+                                unset)\n+                                    _arguments \\\n+                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \\\n+                                        '--mode=[output format]:mode:(text json)' \\\n+                                        '*:config file:_files -g \"*.json\"'\n+                                    ;;\n+                                edit)\n+                                    _arguments \\\n+                                        '--mode=[report format]:mode:(text json)' \\\n+                                        '*:config file:_files -g \"*.json\"'\n+                                    ;;\n+                                schema)\n+                                    _arguments \\\n+                                        '--mode=[output format]:mode:(text json)'\n+                                    ;;\n+                                *)\n+                                    # `config show` accepts the normal override\n+                                    # flags so the merged result is previewed.\n+                                    _arguments \\\n+                                        '--json[emit the stable JSON object (schema-pinned)]' \\\n+                                        $global_opts\n+                                    ;;\n+                            esac\n+                            ;;\n+                    esac\n+                    ;;\n+\n+                init)\n+                    _arguments \\\n+                        '--force[overwrite an existing config file]' \\\n+                        '--stdout[print the starter config without writing it]' \\\n+                        '--provider=[scaffold for a specific provider]:provider:(xiaomi openai deepseek opencode-go)' \\\n+                        '--json[emit the stable schema-checked result object]'\n+                    ;;\n+\n+                setup)\n+                    _arguments \\\n+                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \\\n+                        '--client=[editor ACP client]:client:(zed nvim emacs vscode cursor jetbrains windsurf gemini claude-desktop opencode cline goose continue roo-code kilo-code amazonq codex all)' \\\n+                        '--offline[skip network checks in the doctor step]' \\\n+                        '--deep[run an authenticated probe in the doctor step]' \\\n+                        '(-y --yes)'{-y,--yes}'[unattended: approve all write steps]' \\\n+                        '--non-interactive[unattended contract for scripts/CI]' \\\n+                        '--dry-run[preview write steps; change nothing]' \\\n+                        '--remove[reverse per-client editor wiring]' \\\n+                        '--uninstall[alias for --remove]' \\\n+                        '--import[merge existing MCP server entries into wired MCP clients]' \\\n+                        '--detect[read-only client inventory: config paths + wiring status]' \\\n+                        '--provider=[seed scaffold + diagnose provider]:provider:(xiaomi openai deepseek opencode-go)' \\\n+                        '--model=[diagnose an override model]:model:' \\\n+                        '--api-key=[diagnose an override API key]:key:' \\\n+                        '--json[emit the stable schema-checked NDJSON stream]'\n+                    ;;\n+\n+                completions)\n+                    _arguments \\\n+                        '1: :(install)' \\\n+                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \\\n+                        '--dry-run[preview the install; change nothing]' \\\n+                        '--json[emit the stable schema-checked result object]'\n+                    ;;\n+\n+                doctor)\n+                    _arguments \\\n+                        '--offline[skip network checks]' \\\n+                        '--deep[run an authenticated probe (spends ~1 token)]' \\\n+                        '--probe[live-verify connectivity and credentials for every provider]' \\\n+                        '--selftest[credential-free end-to-end session against a loopback stub]' \\\n+                        '--fix[remediate fixable checks (prompts per fix)]' \\\n+                        '--yes[apply --fix remediations without prompting]' \\\n+                        '--json[stream NDJSON check/fix events + done:true verdict]' \\\n+                        '--report[Markdown diagnostics bundle for bug reports]' \\\n+                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \\\n+                        '--provider=[diagnose an override provider]:provider:(xiaomi openai deepseek opencode-go)' \\\n+                        '--model=[diagnose an override model]:model:' \\\n+                        '--api-key=[diagnose an override API key]:key:'\n+                    ;;\n+\n+                bug)\n+                    _arguments \\\n+                        '--title=[issue title]:title:' \\\n+                        '--body=[description above the bundle]:text:' \\\n+                        '--labels=[issue labels (csv)]:labels:' \\\n+                        '--open[open the issue URL in the system browser]' \\\n+                        '--out=[write the diagnostics bundle to a file]:file:_files' \\\n+                        '--no-report[omit the diagnostics bundle]' \\\n+                        '--attach-report=[use an existing report file as the bundle]:file:_files' \\\n+                        '--offline[skip network checks]' \\\n+                        '--deep[run an authenticated probe (spends ~1 token)]' \\\n+                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \\\n+                        '--provider=[diagnose an override provider]:provider:(xiaomi openai deepseek opencode-go)' \\\n+                        '--model=[diagnose an override model]:model:' \\\n+                        '--api-key=[diagnose an override API key]:key:' \\\n+                        '--json[emit the stable schema-checked JSON form]'\n+                    ;;\n+\n+                guide)\n+                    _arguments '--human[render the guide as markdown]'\n+                    ;;\n+\n+                models)\n+                    # `tau models` takes no further arguments.\n+                    ;;\n+\n+                version)\n+                    _arguments \\\n+                        '--verbose[include build metadata (commit, target, build date, zig version)]' \\\n+                        '--check[non-blocking update check against the latest release]' \\\n+                        '--json[emit the stable {\"name\",\"version\",...} object]' \\\n+                        '--mode=[output mode]:mode:(text json)'\n+                    ;;\n+\n+                upgrade)\n+                    _arguments \\\n+                        '(-y --yes)'{-y,--yes}'[upgrade without prompting]' \\\n+                        '--dir=[install destination]:dir:_files -/' \\\n+                        '--dry-run[print the resolved plan; install nothing]' \\\n+                        '--verify-signature[verify the cosign signature bundle before the swap]' \\\n+                        '--json[emit the stable schema-checked report object]'\n+                    ;;\n+\n+                explain)\n+                    # Exit codes mirror the stable catalog in src/errors.zig;\n+                    # config keys mirror the generated docs/config.md table;\n+                    # doctor.* ids mirror the CheckSpec catalog in\n+                    # src/doctorcatalog.zig; TAU_* names mirror the Spec\n+                    # registry in src/envvars.zig.\n+                    local -a err_codes=(\n+                        '1:not_found'\n+                        '80:invalid_argument'\n+                        '82:missing_required_field'\n+                        '105:Timeout'\n+                        '106:AuthFailed'\n+                        '110:internal_error'\n+                        '111:unimplemented'\n+                    )\n+                    local -a cfg_keys=(\n+                        '$schema:config key' 'provider:config key' 'model:config key'\n+                        'api_key:config key' 'keys:config key' 'mode:config key'\n+                        'stream:config key' 'thinking:config key' 'debug:config key'\n+                        'temperature:config key' 'max_tokens:config key'\n+                        'timeout_ms:config key' 'context_window:config key'\n+                        'auto_compact:config key' 'compact_threshold:config key'\n+                        'compact_keep_recent:deprecated config key' 'compact_keep_recent_tokens:config key'\n+                        'goal_max_iterations:config key' 'goal_max_continues:config key'\n+                        'keys.xiaomi:config key' 'keys.openai:config key'\n+                        'keys.deepseek:config key' 'keys.opencode-go:config key'\n+                    )\n+                    local -a checks=(\n+                        'doctor.config_deprecated_keys:doctor check' 'doctor.config_file:doctor check'\n+                        'doctor.config_permissions:doctor check'\n+                        'doctor.plaintext_secrets:doctor check'\n+                        'doctor.shell_completions:doctor check'\n+                        'doctor.provider_resolution:doctor check'\n+                        'doctor.api_key:doctor check'\n+                        'doctor.curl:doctor check'\n+                        'doctor.proxy_env:doctor check'\n+                        'doctor.tls_ca:doctor check'\n+                        'doctor.endpoint_reachable:doctor check'\n+                        'doctor.auth_probe:doctor check'\n+                        'doctor.client_wiring:doctor check'\n+                        'doctor.client_permissions:doctor check'\n+                        'doctor.provider_probes:doctor check'\n+                        'doctor.update_available:doctor check'\n+                        'doctor.selftest:doctor check'\n+                        'doctor.client_zed:doctor check'\n+                        'doctor.client_nvim:doctor check'\n+                        'doctor.client_emacs:doctor check'\n+                        'doctor.client_vscode:doctor check'\n+                        'doctor.client_cursor:doctor check'\n+                        'doctor.client_jetbrains:doctor check'\n+                        'doctor.client_windsurf:doctor check'\n+                        'doctor.client_gemini:doctor check'\n+                        'doctor.client_claude_desktop:doctor check'\n+                        'doctor.client_opencode:doctor check'\n+                        'doctor.client_cline:doctor check'\n+                        'doctor.client_goose:doctor check'\n+                        'doctor.client_continue:doctor check'\n+                        'doctor.client_roo_code:doctor check'\n+                        'doctor.client_kilo_code:doctor check'\n+                        'doctor.client_amazonq:doctor check'\n+                        'doctor.client_codex:doctor check'\n+                        'doctor.probe_xiaomi:doctor check'\n+                        'doctor.probe_xiaomi_auth:doctor check'\n+                        'doctor.probe_openai:doctor check'\n+                        'doctor.probe_openai_auth:doctor check'\n+                        'doctor.probe_deepseek:doctor check'\n+                        'doctor.probe_deepseek_auth:doctor check'\n+                        'doctor.probe_opencode-go:doctor check'\n+                        'doctor.probe_opencode-go_auth:doctor check'\n+                    )\n+                    local -a env_vars=(\n+                        'TAU_API_KEY:env var' 'TAU_ENDPOINT:env var'\n+                        'TAU_DEBUG_LOG:env var' 'TAU_EDITOR:env var'\n+                        'TAU_YES:env var' 'TAU_NONINTERACTIVE:env var'\n+                        'TAU_SETUP_SHELL:env var' 'TAU_SETUP_CLIENT:env var'\n+                        'TAU_SETUP_IMPORT:env var' 'TAU_NO_UPDATE_CHECK:env var'\n+                        'TAU_UPDATE_URL:env var' 'TAU_INSTALL_URL:env var'\n+                        'TAU_CHANGELOG_URL:env var' 'TAU_INSTALL_DIR:env var'\n+                        'TAU_VERIFY_SIGSTORE:env var' 'TAU_VERSION:env var'\n+                        'TAU_BASE_URL:env var' 'TAU_OS:env var'\n+                        'TAU_ARCH:env var' 'TAU_SKIP_CHECKSUM:env var'\n+                        'TAU_BIN:env var' 'TAU_TOOLS:env var'\n+                        'TAU_THINKING:env var' 'TAU_DEBUG:env var'\n+                    )\n+                    _arguments \\\n+                        '1: :_describe \"error code/type, config key, doctor check, or TAU_* env var\" err_codes cfg_keys checks env_vars' \\\n+                        '--json[emit the stable schema-checked JSON form]' \\\n+                        '--human[render the entry as prose instead of JSON]'\n+                    ;;\n+            esac\n+            ;;\n+    esac\n+}\n+\n+_tau \"$@\"\n"},{"path":"<HOME>/.zshrc","action":"create","diff":"--- /dev/null\n+++ b/<HOME>/.zshrc\n@@ -0,0 +1,3 @@\n+# tau completions\n+fpath=(~/.zsh/completions $fpath)\n+autoload -Uz compinit && compinit\n"}]}],"dry_run":true,"version":"0.4.0","done":true}
