{"errors":[{"code":1,"type":"not_found","recoverable":false,"cause":"a named resource is missing — the message identifies the file, skill, or session","hint":"the message names what was not found — check the name/path and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":80,"type":"invalid_argument","recoverable":false,"cause":"an unknown flag, bad flag value, invalid subcommand, or malformed argument was passed","hint":"run `tau --help` (or `tau --help-json`) for the valid flags and values","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":82,"type":"missing_required_field","recoverable":false,"cause":"a required input is missing (e.g. `tau fleet run` without --goal, `tau skills load` without a name)","hint":"the message names the missing input — supply it and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":105,"type":"Timeout","recoverable":false,"cause":"an HTTP request to the provider endpoint exceeded --timeout-ms","hint":"raise --timeout-ms (default 120000) or check the endpoint/network (TAU_ENDPOINT)","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":106,"type":"AuthFailed","recoverable":false,"cause":"the provider rejected the API key, or no key was found anywhere in the resolution chain","hint":"provide an API key via --api-key, the provider env var, config.json, or TAU_API_KEY","docs":"https://github.com/javimosch/tau/blob/master/docs/providers.md"},{"code":110,"type":"internal_error","recoverable":false,"cause":"an HTTP failure, JSON parse error, tool crash, or the --max-iterations cap was hit","hint":"re-run with --debug to write a diagnostic log, then file a bug report","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":111,"type":"unimplemented","recoverable":false,"cause":"the operation is not supported on this platform (e.g. `tau acp` daemon commands are POSIX-only)","hint":"not supported on this platform — the message names the workaround","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"}],"config_keys":[{"key":"$schema","type":"string","constraints":"—","description":"Editor hint pointing at this schema. Written by `tau init`; accepted but ignored by the loader.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"provider","type":"string","constraints":"one of `xiaomi` | `openai` | `deepseek` | `opencode-go`","description":"Active provider name — selects the API endpoint and default model. TAU_ENDPOINT overrides the endpoint.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"model","type":"string","constraints":"—","description":"Model id, or 'provider/id' shorthand. Defaults to the provider's default model.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"api_key","type":"string","constraints":"non-empty","description":"Global API key — used only when no keys[] entry or provider env var matches. Stored in plaintext; prefer env vars.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys","type":"object","constraints":"member names: `xiaomi` | `openai` | `deepseek` | `opencode-go`; values: non-empty strings","description":"Per-provider API keys — an entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"mode","type":"string","constraints":"one of `text` | `json`","description":"Output format for results: 'json' (agent-friendly envelopes) or 'text' (human-readable prose).","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"stream","type":"boolean","constraints":"—","description":"Stream responses token-by-token (SSE).","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"thinking","type":"boolean","constraints":"—","description":"Emit reasoning/thinking chunks alongside the response.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"debug","type":"boolean","constraints":"—","description":"Write perf stats and tool I/O diagnostics to stderr.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"temperature","type":"number","constraints":"`>= 0`","description":"Sampling temperature.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"max_tokens","type":"integer","constraints":"`0..4294967295`","description":"Cap on output tokens per response.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"timeout_ms","type":"integer","constraints":"`>= 0`","description":"HTTP request timeout in milliseconds.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"context_window","type":"integer","constraints":"`0..4294967295`","description":"Token capacity used for the auto-compaction threshold; defaults to the provider's context window.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"auto_compact","type":"boolean","constraints":"—","description":"Auto-compact history when estimated tokens exceed compact_threshold of context_window.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"compact_threshold","type":"number","constraints":"`0..1`","description":"Fraction of context_window that triggers auto-compaction.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"compact_keep_recent_tokens","type":"integer","constraints":"`0..4294967295`","description":"Recent tokens kept verbatim through compaction.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"goal_max_iterations","type":"integer","constraints":"`0..4294967295`","description":"Per-run agentic loop cap in /goal mode.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"goal_max_continues","type":"integer","constraints":"`0..4294967295`","description":"Cross-invocation continuation cap for goal mode.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.xiaomi","type":"string","constraints":"non-empty","description":"API key for the `xiaomi` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.openai","type":"string","constraints":"non-empty","description":"API key for the `openai` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.deepseek","type":"string","constraints":"non-empty","description":"API key for the `deepseek` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.opencode-go","type":"string","constraints":"non-empty","description":"API key for the `opencode-go` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"}]}
