{"errors":[{"code":1,"type":"not_found","recoverable":false,"cause":"a named resource is missing — the message identifies the file, skill, or session","hint":"the message names what was not found — check the name/path and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":80,"type":"invalid_argument","recoverable":false,"cause":"an unknown flag, bad flag value, invalid subcommand, or malformed argument was passed","hint":"run `tau --help` (or `tau --help-json`) for the valid flags and values","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":82,"type":"missing_required_field","recoverable":false,"cause":"a required input is missing (e.g. `tau fleet run` without --goal, `tau skills load` without a name)","hint":"the message names the missing input — supply it and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":105,"type":"Timeout","recoverable":false,"cause":"an HTTP request to the provider endpoint exceeded --timeout-ms","hint":"raise --timeout-ms (default 120000) or check the endpoint/network (TAU_ENDPOINT)","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":106,"type":"AuthFailed","recoverable":false,"cause":"the provider rejected the API key, or no key was found anywhere in the resolution chain","hint":"provide an API key via --api-key, the provider env var, config.json, or TAU_API_KEY","docs":"https://github.com/javimosch/tau/blob/master/docs/providers.md"},{"code":110,"type":"internal_error","recoverable":false,"cause":"an HTTP failure, JSON parse error, tool crash, or the --max-iterations cap was hit","hint":"re-run with --debug to write a diagnostic log, then file a bug report","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":111,"type":"unimplemented","recoverable":false,"cause":"the operation is not supported on this platform (e.g. `tau acp` daemon commands are POSIX-only)","hint":"not supported on this platform — the message names the workaround","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"}],"config_keys":[{"key":"$schema","type":"string","constraints":"—","description":"Editor hint pointing at this schema. Written by `tau init`; accepted but ignored by the loader.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"provider","type":"string","constraints":"one of `xiaomi` | `openai` | `deepseek` | `opencode-go`","description":"Active provider name — selects the API endpoint and default model. TAU_ENDPOINT overrides the endpoint.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"model","type":"string","constraints":"—","description":"Model id, or 'provider/id' shorthand. Defaults to the provider's default model.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"api_key","type":"string","constraints":"non-empty","description":"Global API key — used only when no keys[] entry or provider env var matches. Stored in plaintext; prefer env vars.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys","type":"object","constraints":"member names: `xiaomi` | `openai` | `deepseek` | `opencode-go`; values: non-empty strings","description":"Per-provider API keys — an entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"mode","type":"string","constraints":"one of `text` | `json`","description":"Output format for results: 'json' (agent-friendly envelopes) or 'text' (human-readable prose).","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"stream","type":"boolean","constraints":"—","description":"Stream responses token-by-token (SSE).","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"thinking","type":"boolean","constraints":"—","description":"Emit reasoning/thinking chunks alongside the response.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"debug","type":"boolean","constraints":"—","description":"Write perf stats and tool I/O diagnostics to stderr.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"temperature","type":"number","constraints":"`>= 0`","description":"Sampling temperature.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"max_tokens","type":"integer","constraints":"`0..4294967295`","description":"Cap on output tokens per response.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"timeout_ms","type":"integer","constraints":"`>= 0`","description":"HTTP request timeout in milliseconds.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"context_window","type":"integer","constraints":"`0..4294967295`","description":"Token capacity used for the auto-compaction threshold; defaults to the provider's context window.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"auto_compact","type":"boolean","constraints":"—","description":"Auto-compact history when estimated tokens exceed compact_threshold of context_window.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"compact_threshold","type":"number","constraints":"`0..1`","description":"Fraction of context_window that triggers auto-compaction.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"compact_keep_recent_tokens","type":"integer","constraints":"`0..4294967295`","description":"Recent tokens kept verbatim through compaction.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"goal_max_iterations","type":"integer","constraints":"`0..4294967295`","description":"Per-run agentic loop cap in /goal mode.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"goal_max_continues","type":"integer","constraints":"`0..4294967295`","description":"Cross-invocation continuation cap for goal mode.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.xiaomi","type":"string","constraints":"non-empty","description":"API key for the `xiaomi` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.openai","type":"string","constraints":"non-empty","description":"API key for the `openai` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.deepseek","type":"string","constraints":"non-empty","description":"API key for the `deepseek` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"},{"key":"keys.opencode-go","type":"string","constraints":"non-empty","description":"API key for the `opencode-go` provider — a keys[] entry outranks that provider's env var and the global api_key.","docs":"https://github.com/javimosch/tau/blob/master/docs/config.md"}],"doctor_checks":[{"check":"config_file","fails_when":"~/.config/tau/config.json doesn't parse (fail), or names an unregistered provider (warn) — a missing file is ok, config is optional","remediation":"fix the JSON or delete the file — `tau config validate` pinpoints the error with line/column; `tau doctor --fix` moves a broken config to config.json.bak and writes a starter","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"config_deprecated_keys","fails_when":"the config file still uses a deprecated or renamed key spelling (e.g. compact_keep_recent) — old spellings still load with a warn envelope during the deprecation window but are scheduled for removal (skipped when there is no config file or it doesn't parse)","remediation":"run `tau doctor --fix` to rewrite the deprecated spellings in place — `tau config validate` prints the exact line/column and the canonical key name","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"config_permissions","fails_when":"the config dir or config.json grants group/other read access (POSIX only — the file can hold API keys)","remediation":"run `tau doctor --fix` (chmod 0700 on ~/.config/tau, 0600 on config.json) or chmod them yourself","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"plaintext_secrets","fails_when":"credentials sit on disk as plaintext — api_key/keys.* values in the config file, or `env` blocks inside client settings files (warn only; reports key names and counts, never values)","remediation":"move keys to environment variables — `tau config unset api_key` or `tau config unset keys.<provider>` — the provider env var still resolves; not auto-fixable","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"shell_completions","fails_when":"completion scripts are missing or stale for the detected shells","remediation":"run `tau doctor --fix` or `tau setup --yes` to (re)install them","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"provider_resolution","fails_when":"the configured or --provider provider isn't registered","remediation":"pick a registered provider — `tau models` lists them; `tau config set provider <name>` persists it","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"api_key","fails_when":"no API key resolves at any level of the precedence chain","remediation":"pass --api-key, set the provider env var or TAU_API_KEY, or add api_key/keys.<provider> to config.json — `tau init` scaffolds a starter","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"curl","fails_when":"curl is missing or `curl --version` fails — every LLM request goes through curl","remediation":"install curl via your package manager and re-run `tau doctor`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"proxy_env","fails_when":"a *_proxy/*_PROXY variable looks wrong for the resolved endpoint — unparseable URL, credentials embedded in the URL (always redacted in output), HTTP_PROXY alone for an HTTPS endpoint (silent no-op), or NO_PROXY covering the endpoint host (warn only; runs under --offline)","remediation":"export HTTPS_PROXY for https:// endpoints, drop credentials from the proxy URL, and make sure NO_PROXY doesn't cover the provider host — see \"Behind a corporate proxy\" below","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"tls_ca","fails_when":"CURL_CA_BUNDLE/SSL_CERT_FILE points at a missing or non-file path, or an SSL_CERT_DIR entry is missing (fail — every HTTPS request would error); a configured proxy with no custom CA bundle warns — the corporate TLS-intercept case (runs under --offline)","remediation":"set CURL_CA_BUNDLE (or SSL_CERT_FILE/SSL_CERT_DIR) to your organization's PEM bundle, or fix/remove the missing path","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"endpoint_reachable","fails_when":"the provider endpoint doesn't answer within the probe timeout (skipped under --offline or without curl)","remediation":"check the network, DNS, and the proxy_env/tls_ca rows — TAU_ENDPOINT overrides the endpoint","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"auth_probe","fails_when":"a one-token authenticated completion fails — the resolved key is rejected (--deep only; skipped under --offline, without curl, or with no key resolved)","remediation":"re-issue or rotate the key — the check names which source it resolved from (env var, config, or TAU_API_KEY)","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_wiring","fails_when":"placeholder row — HOME is unset or no editor config dir was detected, so no per-client rows ran","remediation":"install the editor you want wired, then run `tau setup --client <name>`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_permissions","fails_when":"a detected client settings file (or the mcacp bridge config) grants group/other access — `env` blocks inside it can hold API keys (POSIX only)","remediation":"run `tau doctor --fix` (chmod 0600 on every detected client settings file and mcacp.json) or chmod them yourself","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"provider_probes","fails_when":"placeholder row for the opt-in sweep — skipped unless --probe is passed","remediation":"run `tau doctor --probe` to live-verify connectivity and credentials for every registered provider","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"update_available","fails_when":"a newer release exists upstream (warn only; skipped under --offline, TAU_NO_UPDATE_CHECK=1, or without curl)","remediation":"run `tau upgrade` — TAU_NO_UPDATE_CHECK=1 silences the row","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"selftest","fails_when":"the credential-free end-to-end run against a loopback stub provider fails (--selftest only) — the installed binary can't complete a session","remediation":"re-run `tau doctor --selftest --debug` and attach the redacted log to `tau bug`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_zed","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client zed` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/zed.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_nvim","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client nvim` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/nvim.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_emacs","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client emacs` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/emacs.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_vscode","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client vscode` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/vscode.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_cursor","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client cursor` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/cursor.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_jetbrains","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client jetbrains` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/jetbrains.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_windsurf","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client windsurf` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/windsurf.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_gemini","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client gemini` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/gemini-cli.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_claude_desktop","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client claude-desktop` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/claude-desktop.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_opencode","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client opencode` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/opencode.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_cline","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client cline` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/cline.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_goose","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client goose` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/goose.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_continue","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client continue` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/continue.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_roo_code","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client roo-code` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/roo-code.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_kilo_code","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client kilo-code` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/kilo-code.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_amazonq","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client amazonq` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/amazonq.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"client_codex","fails_when":"tau isn't wired into that client's settings, or the wiring is stale — a dead `command` path or wrong `args` counts as stale; the row is absent entirely when the client isn't installed","remediation":"run `tau setup --client codex` to wire or refresh it — `tau doctor --fix` auto-fixes the bridge/ACP clients and writes a paste-ready snippet for the manual ones; guide: docs/clients/codex.md","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_xiaomi","fails_when":"the `--probe` connectivity check against that provider's endpoint failed or timed out","remediation":"verify network reachability — DNS, firewall, and the proxy_env/tls_ca rows; the endpoint is listed by `tau models`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_xiaomi_auth","fails_when":"the `--probe` credential check failed — the key resolved for that provider was rejected by a one-token authenticated completion","remediation":"re-issue or rotate the key — it resolves from the provider's env var, keys.xiaomi in config.json, TAU_API_KEY, or --api-key","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_openai","fails_when":"the `--probe` connectivity check against that provider's endpoint failed or timed out","remediation":"verify network reachability — DNS, firewall, and the proxy_env/tls_ca rows; the endpoint is listed by `tau models`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_openai_auth","fails_when":"the `--probe` credential check failed — the key resolved for that provider was rejected by a one-token authenticated completion","remediation":"re-issue or rotate the key — it resolves from the provider's env var, keys.openai in config.json, TAU_API_KEY, or --api-key","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_deepseek","fails_when":"the `--probe` connectivity check against that provider's endpoint failed or timed out","remediation":"verify network reachability — DNS, firewall, and the proxy_env/tls_ca rows; the endpoint is listed by `tau models`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_deepseek_auth","fails_when":"the `--probe` credential check failed — the key resolved for that provider was rejected by a one-token authenticated completion","remediation":"re-issue or rotate the key — it resolves from the provider's env var, keys.deepseek in config.json, TAU_API_KEY, or --api-key","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_opencode-go","fails_when":"the `--probe` connectivity check against that provider's endpoint failed or timed out","remediation":"verify network reachability — DNS, firewall, and the proxy_env/tls_ca rows; the endpoint is listed by `tau models`","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"},{"check":"probe_opencode-go_auth","fails_when":"the `--probe` credential check failed — the key resolved for that provider was rejected by a one-token authenticated completion","remediation":"re-issue or rotate the key — it resolves from the provider's env var, keys.opencode-go in config.json, TAU_API_KEY, or --api-key","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md#setup--config-problems--tau-doctor"}],"env_vars":[{"env":"TAU_API_KEY","section":"tau","consumers":"tau","summary":"Fallback API key, used after provider-specific env vars and config keys.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_ENDPOINT","section":"tau","consumers":"tau","summary":"Overrides the provider's endpoint URL (works for chat and `tau acp`). Useful for proxies, gateways, and local OpenAI-compatible servers.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_DEBUG_LOG","section":"tau","consumers":"tau","summary":"Overrides the `--debug` diagnostic log destination (default `~/.config/tau/debug/<timestamp>.log`).","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_EDITOR","section":"tau","consumers":"tau","summary":"Editor for `tau config edit`, tried before VISUAL and EDITOR (fallback `vi`/`notepad`). May include arguments, e.g. `code --wait`.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_YES","section":"tau","consumers":"tau","summary":"`1`/`true`/`yes`/`on` enables `tau setup --yes` and `tau upgrade --yes` (approve write steps without prompting). Any other value is off.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_NONINTERACTIVE","section":"tau","consumers":"tau","summary":"Same truthiness rules as TAU_YES; enables `tau setup --non-interactive` (unattended contract for scripts/CI).","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_SETUP_SHELL","section":"tau","consumers":"tau","summary":"`tau setup` shell override when `--shell` is absent (`bash`, `zsh`, `fish`, `pwsh`, or `all`); invalid values fail with exit 80.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_SETUP_CLIENT","section":"tau","consumers":"tau","summary":"`tau setup` editor client when `--client` is absent (any `--client` value or `all`); invalid values fail with exit 80.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_SETUP_IMPORT","section":"tau","consumers":"tau","summary":"Same truthiness rules as TAU_YES; enables `tau setup --import` (merge existing MCP servers into wired clients).","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_NO_UPDATE_CHECK","section":"tau","consumers":"tau","summary":"Any non-empty, non-`0` value disables the update check everywhere — `tau version --check`, `tau upgrade`, and the `tau doctor` update_available warning.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_UPDATE_URL","section":"tau","consumers":"tau","summary":"Overrides the release lookup URL used by the update check (default: the GitHub latest-release API). Useful for mirrors/proxies and `file://` stubs in tests.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_INSTALL_URL","section":"tau","consumers":"tau","summary":"Overrides the installer script `tau upgrade` downloads and runs (default: the install.sh shipped at the release tag). Useful for mirrors and `file://` stubs in tests.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_CHANGELOG_URL","section":"tau","consumers":"tau","summary":"Overrides the changelog `tau upgrade` fetches for its pre-upgrade summary (default: the CHANGELOG.md shipped at the release tag). A fetch miss drops the summary, never the upgrade.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_INSTALL_DIR","section":"tau","consumers":"tau upgrade · install.sh · install.ps1","summary":"Install destination when `tau upgrade --dir` is absent (default: the running binary's own directory, else the installer's `~/.local/bin`). Also honored by the installers.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_VERIFY_SIGSTORE","section":"tau","consumers":"tau upgrade · install.sh","summary":"Opt-in cosign/Sigstore verification of the downloaded binary before swap (requires cosign on PATH). Truthiness follows TAU_YES.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_VERSION","section":"installer","consumers":"install.sh · install.ps1","summary":"Pins the version to install (default: the latest release). Same role as `--version`/`-Version`.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_BASE_URL","section":"installer","consumers":"install.sh · install.ps1","summary":"Overrides the release-download base URL. `file://` mirrors are supported for air-gapped installs.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_OS","section":"installer","consumers":"install.sh","summary":"Overrides platform detection — the raw `uname` value (`linux` or `darwin`).","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_ARCH","section":"installer","consumers":"install.sh · install.ps1","summary":"Overrides architecture detection — the raw `uname -m` value (e.g. `x86_64`, `arm64`, `aarch64`).","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_SKIP_CHECKSUM","section":"installer","consumers":"install.sh · install.ps1","summary":"Skips SHA256 verification of the downloaded archive — weakens the fail-closed default; prefer TAU_VERIFY_SIGSTORE.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_BIN","section":"external","consumers":"a2a-spawn · scripts/smoke.sh","summary":"Path to the tau binary, skipping PATH resolution.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_TOOLS","section":"external","consumers":"a2a-spawn","summary":"Translated to `--tools` when launching tau (e.g. `TAU_TOOLS=\"bash,read\"`). tau itself ignores it.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_THINKING","section":"external","consumers":"a2a-spawn","summary":"`1` adds `--thinking` when launching tau. tau itself ignores it.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"},{"env":"TAU_DEBUG","section":"external","consumers":"a2a-spawn","summary":"`1` adds `--debug` when launching tau. tau itself ignores it.","docs":"https://github.com/javimosch/tau/blob/master/docs/env.md"}],"clients":[{"client":"zed","transport":"acp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client zed --yes","config_dir":"~/.config/zed","settings_path":"~/.config/zed/settings.json","snippet_path":"~/.config/tau/snippets/zed.jsonc","verify":"open the Agent Panel, click +, and pick tau","doctor_check":"client_zed","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/zed.md"},{"client":"nvim","transport":"acp","wiring":"snippet","prereqs":"Neovim with avante.nvim or CodeCompanion.nvim installed; tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client nvim --yes","config_dir":"~/.config/nvim","settings_path":"~/.config/nvim/init.lua","snippet_path":"~/.config/tau/snippets/nvim.lua","verify":"pick the tau provider/adapter in your plugin (e.g. :AvanteSwitchProvider)","doctor_check":"client_nvim","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/nvim.md"},{"client":"emacs","transport":"acp","wiring":"snippet","prereqs":"Emacs 29.1+ with agent-shell and acp installed from MELPA; tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client emacs --yes","config_dir":"~/.emacs.d","settings_path":"~/.emacs.d/init.el","snippet_path":"~/.config/tau/snippets/emacs.el","verify":"paste the snippet into your init file, restart Emacs, run M-x agent-shell and pick tau","doctor_check":"client_emacs","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/emacs.md"},{"client":"vscode","transport":"acp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client vscode --yes","config_dir":"~/.config/Code","settings_path":"~/.config/Code/User/settings.json","snippet_path":"~/.config/tau/snippets/vscode.jsonc","verify":"install the ACP Client extension, run 'ACP: Connect to Agent', pick tau","doctor_check":"client_vscode","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/vscode.md"},{"client":"cursor","transport":"acp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client cursor --yes","config_dir":"~/.config/Cursor","settings_path":"~/.config/Cursor/User/settings.json","snippet_path":"~/.config/tau/snippets/cursor.jsonc","verify":"install the ACP Client extension (Open VSX), run 'ACP: Connect to Agent', pick tau","doctor_check":"client_cursor","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/cursor.md"},{"client":"jetbrains","transport":"acp","wiring":"direct","prereqs":"a JetBrains IDE with AI Assistant 2025.1 or newer (custom agents are not supported under WSL — use a native Windows or Linux/macOS install); tau installed and configured — `tau doctor` reports an ok provider and API key","setup":"tau setup --client jetbrains --yes","config_dir":"~/.jetbrains","settings_path":"~/.jetbrains/acp.json","snippet_path":"~/.config/tau/snippets/jetbrains.jsonc","verify":"open the AI Chat tool window and pick tau in the agent selector","doctor_check":"client_jetbrains","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/jetbrains.md"},{"client":"windsurf","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Windsurf sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client windsurf --yes","config_dir":"~/.codeium/windsurf","settings_path":"~/.codeium/windsurf/mcp_config.json","snippet_path":"~/.config/tau/snippets/windsurf.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart Windsurf, and confirm the mcacp server in Settings > MCP servers","doctor_check":"client_windsurf","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/windsurf.md"},{"client":"gemini","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Gemini CLI sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client gemini --yes","config_dir":"~/.gemini","settings_path":"~/.gemini/settings.json","snippet_path":"~/.config/tau/snippets/gemini.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart Gemini CLI, and run /mcp to see tau's tools","doctor_check":"client_gemini","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/gemini-cli.md"},{"client":"claude-desktop","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Claude Desktop sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client claude-desktop --yes","config_dir":"~/.config/Claude","settings_path":"~/.config/Claude/claude_desktop_config.json","snippet_path":"~/.config/tau/snippets/claude-desktop.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart Claude Desktop, and find tau's tools under the mcacp server","doctor_check":"client_claude_desktop","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/claude-desktop.md"},{"client":"opencode","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH OpenCode sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client opencode --yes","config_dir":"~/.config/opencode","settings_path":"~/.config/opencode/opencode.json","snippet_path":"~/.config/tau/snippets/opencode.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart OpenCode, and check the mcacp server with 'opencode mcp list'","doctor_check":"client_opencode","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/opencode.md"},{"client":"cline","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH VS Code sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client cline --yes","config_dir":"~/.config/Code/User/globalStorage/saoudrizwan.claude-dev","settings_path":"~/.config/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json","snippet_path":"~/.config/tau/snippets/cline.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart VS Code, and confirm the mcacp server under MCP Servers in the Cline pane","doctor_check":"client_cline","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/cline.md"},{"client":"goose","transport":"mcacp","wiring":"snippet","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Goose sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client goose --yes","config_dir":"~/.config/goose","settings_path":"~/.config/goose/config.yaml","snippet_path":"~/.config/tau/snippets/goose.yaml","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), merge the snippet into ~/.config/goose/config.yaml, then run 'goose session' and ask about the mcacp tools","doctor_check":"client_goose","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/goose.md"},{"client":"continue","transport":"mcacp","wiring":"snippet","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Continue sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client continue --yes","config_dir":"~/.continue","settings_path":"~/.continue/config.yaml","snippet_path":"~/.config/tau/snippets/continue.yaml","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), merge the snippet into ~/.continue/config.yaml, restart Continue, and use agent mode to see tau's tools","doctor_check":"client_continue","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/continue.md"},{"client":"roo-code","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH VS Code sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client roo-code --yes","config_dir":"~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline","settings_path":"~/.config/Code/User/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json","snippet_path":"~/.config/tau/snippets/roo-code.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart VS Code, and confirm the mcacp server under MCP Servers in the Roo Code pane","doctor_check":"client_roo_code","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/roo-code.md"},{"client":"kilo-code","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH the Kilo Code process sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client kilo-code --yes","config_dir":"~/.config/kilo","settings_path":"~/.config/kilo/kilo.jsonc","snippet_path":"~/.config/tau/snippets/kilo-code.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), restart Kilo Code, and confirm the mcacp server under Agent Behaviour > MCP Servers (or run 'kilo mcp list')","doctor_check":"client_kilo_code","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/kilo-code.md"},{"client":"amazonq","transport":"mcacp","wiring":"direct","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH the `q` process sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client amazonq --yes","config_dir":"~/.aws/amazonq","settings_path":"~/.aws/amazonq/mcp.json","snippet_path":"~/.config/tau/snippets/amazonq.jsonc","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), then run 'q chat' (or restart the IDE plugin) and check the mcacp server with /mcp","doctor_check":"client_amazonq","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/amazonq.md"},{"client":"codex","transport":"mcacp","wiring":"snippet","prereqs":"tau installed and configured — `tau doctor` reports an ok provider and API key; Node.js with `npx` on the PATH Codex sees — the bridge runs as `npx -y mcacp` (or install it once with `npm i -g mcacp`)","setup":"tau setup --client codex --yes","config_dir":"~/.codex","settings_path":"~/.codex/config.toml","snippet_path":"~/.config/tau/snippets/codex.toml","bridge_path":"~/.config/mcacp/mcacp.json","verify":"install mcacp (npm i -g mcacp or npx), merge the snippet into ~/.codex/config.toml, then run 'codex mcp list' to confirm the mcacp server","doctor_check":"client_codex","docs":"https://github.com/javimosch/tau/blob/master/docs/clients/codex.md"}]}
