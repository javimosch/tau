{"errors":[{"code":1,"type":"not_found","recoverable":false,"cause":"a named resource is missing — the message identifies the file, skill, or session","hint":"the message names what was not found — check the name/path and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":80,"type":"invalid_argument","recoverable":false,"cause":"an unknown flag, bad flag value, invalid subcommand, or malformed argument was passed","hint":"run `tau --help` (or `tau --help-json`) for the valid flags and values","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":82,"type":"missing_required_field","recoverable":false,"cause":"a required input is missing (e.g. `tau fleet run` without --goal, `tau skills load` without a name)","hint":"the message names the missing input — supply it and retry","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":105,"type":"Timeout","recoverable":false,"cause":"an HTTP request to the provider endpoint exceeded --timeout-ms","hint":"raise --timeout-ms (default 120000) or check the endpoint/network (TAU_ENDPOINT)","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":106,"type":"AuthFailed","recoverable":false,"cause":"the provider rejected the API key, or no key was found anywhere in the resolution chain","hint":"provide an API key via --api-key, the provider env var, config.json, or TAU_API_KEY","docs":"https://github.com/javimosch/tau/blob/master/docs/providers.md"},{"code":110,"type":"internal_error","recoverable":false,"cause":"an HTTP failure, JSON parse error, tool crash, or the --max-iterations cap was hit","hint":"re-run with --debug to write a diagnostic log, then file a bug report","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"},{"code":111,"type":"unimplemented","recoverable":false,"cause":"the operation is not supported on this platform (e.g. `tau acp` daemon commands are POSIX-only)","hint":"not supported on this platform — the message names the workaround","docs":"https://github.com/javimosch/tau/blob/master/docs/troubleshooting.md"}]}
