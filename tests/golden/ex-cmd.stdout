{"subcommand":"doctor","summary":"Validate your setup — config file, credentials, client wiring, connectivity","usage":"tau doctor [--offline|--deep|--probe|--selftest] [--fix [-y|--yes]] [--client <name>] [--json|--report]","examples":["tau doctor","tau doctor --offline","tau doctor --fix --yes","tau doctor --json"],"errors":["invalid_argument"],"config_keys":["provider","api_key","timeout_ms"],"doctor_checks":["doctor.config_file","doctor.provider_resolution","doctor.api_key","doctor.tls_ca","doctor.update_available"],"docs":"https://github.com/javimosch/tau/blob/master/docs/doctor.md"}
