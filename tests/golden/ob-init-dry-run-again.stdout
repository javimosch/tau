{"config_path":"<HOME>/.config/tau/config.json","provider":"xiaomi","created":false,"overwritten":false,"detected_env_keys":[],"dry_run":true,"action":"create","files":[{"path":"<HOME>/.config/tau","action":"create_dir"},{"path":"<HOME>/.config/tau/config.json","action":"create","format":"jsonc","content":"// tau configuration -- generated by `tau init`.\n// This file is JSONC: \"//\" line comments and \"/* block */\" comments are ignored.\n// Reference: docs/configuration.md | `tau guide` | `tau --help`\n//\n// API key resolution order:\n//   --api-key flag > keys[\"<provider>\"] > provider env var > \"api_key\" > TAU_API_KEY\n//\n// Provider API-key environment variables (* = detected on this machine):\n//   XIAOMI_API_KEY | PIZIG_API_KEY  -> \"xiaomi\"\n//   OPENAI_API_KEY  -> \"openai\"\n//   DEEPSEEK_API_KEY  -> \"deepseek\"\n//   OPENCODE_API_KEY  -> \"opencode-go\"\n//   TAU_API_KEY  -> fallback for any provider\n//   none detected -- export one of the env vars above, or set \"api_key\" below\n//\n{\n  // JSON Schema for editor autocomplete/validation (`tau config schema`).\n  \"$schema\": \"https://raw.githubusercontent.com/javimosch/tau/master/schema/tau-config.schema.json\",\n\n  // Active provider. One of:\n  //   xiaomi | openai | deepseek | opencode-go\n  // The API endpoint is derived from the provider; the TAU_ENDPOINT env\n  // var overrides it. \"model\" defaults to the provider's default model.\n  \"provider\": \"xiaomi\",\n\n  // \"model\": \"mimo-v2.5\",\n\n  // Global API key, used when no keys[] entry or env var matches.\n  // Prefer env vars -- this file is plaintext. Uncomment to set:\n  // \"api_key\": \"sk-...\",\n\n  // Per-provider API keys (an entry outranks that provider's env var):\n  // \"keys\": { \"openai\": \"sk-...\" },\n\n  // Output mode: \"json\" (agent-friendly) or \"text\" (human-readable).\n  \"mode\": \"json\",\n\n  // Stream responses token-by-token.\n  \"stream\": true,\n\n  // Sampling temperature.\n  \"temperature\": 0.7,\n\n  // Auto-compaction: summarize history when estimated tokens exceed\n  // compact_threshold of the model's context window.\n  \"auto_compact\": true,\n  \"compact_threshold\": 0.5\n}\n"}]}
