#!/usr/bin/env python3
"""Fake `curl` for offline end-to-end runs of the examples/ cookbook.

tau shells out to the `curl` binary on PATH for all provider HTTP calls
(see src/llm/provider.zig). The smoke "examples" group prepends a directory
containing this shim (named `curl`) to PATH, so every recipe runs the real
tau binary — agent loop, tools, sessions, goal mode — with only the network
leg stubbed. No API key is needed.

Request shapes handled:

  - non-streaming ("stream":false) -> one OpenAI-style JSON body on stdout
  - streaming   ("stream":true)    -> SSE `data:` frames ending in [DONE]

Tool-call planning: the shim reads the goal directive / first user message,
extracts (verb, /abs/path) pairs in order, and emits one tool_call per pair —
read/write/edit — so recipes like "read A then write B" get both turns. A
request that already carries N `"role":"tool"` results gets op N (or a final
answer once ops are exhausted). Goal-mode requests (a system message
containing "GOAL MODE") end with <GOAL_MET> on its own line so the loop
terminates.

Requires python3. Not part of the tau binary.
"""
import json
import re
import sys

# Verbs that imply a tool call, followed somewhere later by an absolute path.
# The lookbehind keeps "re-read", "rewrite", and path segments like
# "/tmp/edit-me.txt" (the "edit" after "/") from matching.
VERB_RE = re.compile(r'(?<![-\w/.])(read|write|create|edit)\b', re.IGNORECASE)
PATH_RE = re.compile(r'/[^\s\'"`,;:()\[\]{}]+')
QUOTE_RE = re.compile(r"'([^']*)'")


def request_body(argv):
    for i, arg in enumerate(argv):
        if arg == "--data-raw" and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith("--data-raw="):
            return arg.split("=", 1)[1]
    return ""


def emit_sse(payload):
    sys.stdout.write("data: " + payload + "\n\n")
    sys.stdout.flush()


def sse_done():
    sys.stdout.write("data: [DONE]\n\n")
    sys.stdout.flush()


def sse_content(text):
    for piece in text.split("\n"):
        emit_sse(json.dumps({"choices": [{"delta": {"content": piece + "\n"}}]}))
    sse_done()


def sse_tool_call(name, arguments_json):
    delta = {
        "choices": [
            {
                "delta": {
                    "tool_calls": [
                        {
                            "index": 0,
                            "id": "call_stub1",
                            "type": "function",
                            "function": {"name": name, "arguments": arguments_json},
                        }
                    ]
                }
            }
        ]
    }
    emit_sse(json.dumps(delta))
    sse_done()


def nonstream_response(content=None, tool_calls=None):
    msg = {"role": "assistant", "content": content}
    if tool_calls:
        msg["tool_calls"] = tool_calls
    out = {
        "id": "chatcmpl-stub",
        "object": "chat.completion",
        "choices": [
            {
                "index": 0,
                "message": msg,
                "finish_reason": "tool_calls" if tool_calls else "stop",
            }
        ],
        "usage": {"total_tokens": 42},
    }
    sys.stdout.write(json.dumps(out))
    return 0


def nonstream_tool_call(name, arguments_json):
    return nonstream_response(
        tool_calls=[
            {
                "id": "call_stub1",
                "type": "function",
                "function": {"name": name, "arguments": arguments_json},
            }
        ]
    )


def ops_text(messages):
    """Text used for tool planning: goal directive (system) + first user msg."""
    parts = []
    user_done = False
    for m in messages:
        if not isinstance(m, dict):
            continue
        content = m.get("content")
        if not isinstance(content, str):
            continue
        if m.get("role") == "system" and "GOAL MODE" in content:
            parts.append(content)
        elif m.get("role") == "user" and not user_done:
            parts.append(content)
            user_done = True
    return "\n".join(parts)


def write_content(text):
    lines = re.findall(r"line\d+:\s*(.+)", text)
    if lines:
        return "\n".join(line.strip() for line in lines) + "\n"
    if "json array" in text.lower():
        return '[{"id":1,"label":"one"},{"id":2,"label":"two"},{"id":3,"label":"three"}]\n'
    return "Generated by tau (stubbed provider).\n"


def plan_ops(text):
    """Ordered [(tool_name, arguments_dict)] inferred from the recipe prompt."""
    ops = []
    matches = list(VERB_RE.finditer(text))
    for idx, m in enumerate(matches):
        verb = m.group(1).lower()
        end_bound = matches[idx + 1].start() if idx + 1 < len(matches) else len(text)
        pm = PATH_RE.search(text, m.end(), end_bound)
        if pm:
            path = pm.group(0).rstrip(".")
        elif ops:
            path = ops[-1][1].get("path", ".")
        else:
            continue
        if verb in ("write", "create"):
            ops.append(("write", {"path": path, "content": write_content(text)}))
        elif verb == "edit":
            quoted = QUOTE_RE.findall(text)
            old = quoted[0] if len(quoted) > 0 else ""
            new = quoted[1] if len(quoted) > 1 else quoted[0] if quoted else ""
            ops.append(("edit", {"path": path, "old_string": old, "new_string": new}))
        else:
            ops.append(("read", {"path": path}))
    return ops


def final_text(messages):
    text = " ".join(
        m.get("content", "")
        for m in messages
        if isinstance(m, dict) and isinstance(m.get("content"), str)
    ).lower()
    if "employees" in text or "json object" in text:
        return json.dumps(
            {
                "employees": [
                    {"name": "Alice", "department": "Engineering", "salary": 95000},
                    {"name": "Bob", "department": "Marketing", "salary": 78000},
                    {"name": "Carol", "department": "Engineering", "salary": 102000},
                ]
            }
        )
    if "release notes" in text:
        return "## Added\n- example recipes\n\n## Fixed\n- minor fixes\n\n## Other\n- chores"
    if "2 + 2" in text or "2+2" in text:
        return "4"
    if "use cases" in text:
        return "CI automation, agent tooling, and structured extraction."
    return "Stub provider response — the recipe ran end-to-end without network."


def goal_mode(messages):
    return any(
        isinstance(m, dict)
        and m.get("role") == "system"
        and isinstance(m.get("content"), str)
        and "GOAL MODE" in m["content"]
        for m in messages
    )


def pick_tool_call(messages, tools):
    """Return (name, arguments_json) for the next tool call, or None."""
    allowed = {
        t.get("function", {}).get("name")
        for t in tools
        if isinstance(t, dict)
    }
    done = sum(1 for m in messages if isinstance(m, dict) and m.get("role") == "tool")
    ops = plan_ops(ops_text(messages))
    if done < len(ops):
        name, args = ops[done]
        if name in allowed:
            return name, json.dumps(args)
        return None
    if done == 0:
        # Tool-enabled call with no recognisable verb: exercise a benign tool
        # once so the agent loop still performs a real tool round-trip.
        if "ls" in allowed:
            return "ls", json.dumps({"path": "."})
        if "read" in allowed:
            return "read", json.dumps({"path": "README.md"})
    return None


def main():
    body = request_body(sys.argv[1:])
    try:
        req = json.loads(body) if body else {}
    except Exception:
        req = {}
    stream = bool(req.get("stream")) or "-N" in sys.argv
    messages = req.get("messages") or []
    tools = req.get("tools") or []

    tool_call = pick_tool_call(messages, tools) if tools else None
    answer = final_text(messages)
    if goal_mode(messages):
        answer = answer.rstrip("\n") + "\n<GOAL_MET>"

    if not stream:
        if tool_call:
            return nonstream_tool_call(*tool_call)
        return nonstream_response(answer)

    if tool_call:
        sse_tool_call(*tool_call)
    else:
        sse_content(answer)
    return 0


if __name__ == "__main__":
    sys.exit(main())
