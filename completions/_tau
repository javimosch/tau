#compdef tau
# zsh completion for tau
# -----------------------------------------------------------------------------
# One-time (current session):
#   source completions/_tau
#
# Permanent:
#   1. Pick (or create) a completions directory in your $fpath, e.g.:
#        mkdir -p ~/.zsh/completions
#   2. Add it to $fpath BEFORE the `compinit` call in ~/.zshrc:
#        fpath=(~/.zsh/completions $fpath)
#   3. Copy this file (the name _tau is required):
#        cp completions/_tau ~/.zsh/completions/_tau
#   4. Rebuild the completion cache:
#        rm -f ~/.zcompdump && compinit

_tau() {
    local curcontext="$curcontext" state line
    typeset -A opt_args

    local -a global_opts=(
        '(-h --help)'{-h,--help}'[show help text]'
        '(-v --version)'{-v,--version}'[show version]'
        '--help-json[output machine-readable help as JSON]'
        '(-p --print)'{-p,--print}'[non-interactive (print-only) mode]'
        '--mode=[output mode]:mode:(text json)'
        '--stream[enable streaming output]'
        '--no-stream[disable streaming output]'
        '--debug[show perf stats and tool calls; write redacted log to ~/.config/tau/debug/]'
        '--dry-run[report tool calls without executing them]'
        '--provider=[LLM provider]:provider:(xiaomi openai deepseek opencode-go)'
        '--model=[model ID or provider/model shorthand]:model:'
        '--api-key=[API key (overrides env vars)]:key:'
        '--system-prompt=[set (replace) system prompt]:prompt:'
        '--append-system-prompt=[append to system prompt (repeatable)]:prompt:'
        '(-t --tools)'{-t,--tools}'=[allowlist of tool names, comma-separated]:tools:(bash ls read write edit grep find calculator)'
        '(-xt --exclude-tools)'{-xt,--exclude-tools}'=[denylist of tool names, comma-separated]:tools:(bash ls read write edit grep find calculator)'
        '(-nt --no-tools)'{-nt,--no-tools}'[disable all built-in tools]'
        '--temperature=[sampling temperature (0.0–2.0)]:float:'
        '--max-tokens=[maximum output tokens]:n:'
        '--timeout-ms=[HTTP request timeout in ms (default 120000)]:ms:'
        '--thinking[enable reasoning/thinking chunks]'
        '--context-window=[override model context window in tokens]:tokens:'
        '--no-compact[disable automatic context compaction]'
        '--compact-threshold=[compaction trigger fraction of context (0–1)]:float:'
        '--compact-keep-recent=[tokens of recent history kept verbatim after compaction]:tokens:'
        '--schema=[JSON Schema for structured output (inline JSON or @file)]:schema:_files'
        '--session=[named session for conversation persistence]:name:'
        '--goal-max-iterations=[per-run loop cap for /goal mode]:n:'
        '--max-iterations=[tool-loop runaway backstop]:n:'
        '--role=[role for adversarial author↔critic loop]:role:(author critic coordinator none)'
        '--scan-agents[scan cwd for AGENTS.md files]'
        '--load-agents-md=[load an AGENTS.md file into system context]:file:_files'
        '--auto-agents-md[auto-load cwd/AGENTS.md on startup]'
    )

    _arguments -C \
        $global_opts \
        ': :->command' \
        '*:: :->command_args'

    case $state in
        command)
            local -a commands=(
                'acp:manage the Agent Client Protocol server (start|stop|status|serve)'
                'models:list available providers and models'
                'skills:manage skills autodiscovery (list|search|load)'
                'fleet:multi-agent orchestration (run|status|list|logs|cancel)'
                'init:write a commented starter config (~/.config/tau/config.json)'
                'config:inspect, validate, or edit the config (show|validate|set|get|unset|edit|schema)'
                'setup:one-shot onboarding (init + completions + doctor)'
                'doctor:validate setup (config, provider, key, connectivity)'
                'bug:file a pre-filled GitHub issue with doctor diagnostics'
                'guide:print the embedded operator manual'
                'version:print version (--verbose adds build metadata)'
                'upgrade:self-update in place via the verified install.sh'
                'explain:offline error-catalog lookup (cause + remediation)'
            )
            _alternative \
                'commands:subcommand:_describe subcommand commands' \
                'files:file path (for @file inclusion):_files'
            ;;

        command_args)
            case ${line[1]} in
                acp)
                    _arguments \
                        '1: :(start stop status serve)' \
                        '--acp-socket=[Unix socket path for ACP daemon]:path:_files' \
                        '--max-iterations=[runaway-loop backstop]:n:'
                    ;;

                fleet)
                    local curcontext="$curcontext" state line
                    local -a fleet_flags=(
                        '--goal=[fleet objective (natural language)]:text:'
                        '--id=[fleet identifier]:id:'
                        '--provider=[LLM provider]:provider:(xiaomi openai deepseek opencode-go)'
                        '--model=[model ID]:model:'
                        '--api-key=[API key]:key:'
                        '--coordinator-model=[coordinator agent model override]:model:'
                        '--worker-model=[worker agent model override]:model:'
                        '--sequential[run worker agents sequentially]'
                        '--parallel[run worker agents in parallel (default)]'
                        '--items=[pre-supplied work items, skips coordinator (JSON)]:json:'
                        '--schema=[JSON Schema for work-item breakdown]:schema:_files'
                    )
                    _arguments -C \
                        '1: :->fleet_sub' \
                        '*:: :->fleet_opts'
                    case $state in
                        fleet_sub)
                            local -a fleet_cmds=(
                                'run:decompose a goal and dispatch to parallel worker agents'
                                'status:check status of a fleet by ID'
                                'list:list all known fleets'
                                'logs:stream worker session logs for a fleet ID'
                                'cancel:cancel a running fleet by ID'
                            )
                            # Flags are valid before the sub-subcommand too.
                            _arguments '1: :_describe "fleet subcommand" fleet_cmds' $fleet_flags
                            ;;
                        fleet_opts)
                            _arguments $fleet_flags
                            ;;
                    esac
                    ;;

                skills)
                    local -a skill_cmds=(
                        'list:list all discoverable skills'
                        'search:search skills by keyword'
                        'load:load a skill into the system context by name'
                    )
                    _arguments '1: :_describe skill_subcommand skill_cmds'
                    ;;

                config)
                    local curcontext="$curcontext" state line
                    _arguments -C \
                        '1: :->config_sub' \
                        '*:: :->config_opts'
                    case $state in
                        config_sub)
                            local -a config_cmds=(
                                'show:print the resolved effective config (keys redacted)'
                                'validate:check a config file (CI/pre-commit)'
                                'set:set a config key to a value'
                                'get:print a config key value (secrets redacted)'
                                'unset:remove a config key'
                                'edit:open the config in $EDITOR (validates on save)'
                                'schema:print the config file JSON Schema (draft 2020-12)'
                            )
                            _describe 'config subcommand' config_cmds
                            ;;
                        config_opts)
                            # $line[1] is the config subcommand just typed.
                            case ${line[1]} in
                                validate)
                                    _arguments \
                                        '--json[emit the stable JSON report (schema-pinned)]' \
                                        '--mode=[report format]:mode:(text json)' \
                                        '*:config file:_files -g "*.json"'
                                    ;;
                                set)
                                    _arguments \
                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \
                                        '2:value:' \
                                        '--mode=[output format]:mode:(text json)' \
                                        '*:config file:_files -g "*.json"'
                                    ;;
                                get)
                                    _arguments \
                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \
                                        '--raw[print secret values unredacted]' \
                                        '--mode=[output format]:mode:(text json)' \
                                        '*:config file:_files -g "*.json"'
                                    ;;
                                unset)
                                    _arguments \
                                        '1:key:(provider model api_key keys mode stream thinking debug temperature max_tokens timeout_ms context_window auto_compact compact_threshold compact_keep_recent_tokens goal_max_iterations goal_max_continues)' \
                                        '--mode=[output format]:mode:(text json)' \
                                        '*:config file:_files -g "*.json"'
                                    ;;
                                edit)
                                    _arguments \
                                        '--mode=[report format]:mode:(text json)' \
                                        '*:config file:_files -g "*.json"'
                                    ;;
                                schema)
                                    _arguments \
                                        '--mode=[output format]:mode:(text json)'
                                    ;;
                                *)
                                    # `config show` accepts the normal override
                                    # flags so the merged result is previewed.
                                    _arguments \
                                        '--json[emit the stable JSON object (schema-pinned)]' \
                                        $global_opts
                                    ;;
                            esac
                            ;;
                    esac
                    ;;

                init)
                    _arguments \
                        '--force[overwrite an existing config file]' \
                        '--stdout[print the starter config without writing it]' \
                        '--provider=[scaffold for a specific provider]:provider:(xiaomi openai deepseek opencode-go)'
                    ;;

                setup)
                    _arguments \
                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \
                        '--client=[editor ACP client]:client:(zed nvim vscode jetbrains windsurf gemini claude-desktop all)' \
                        '--offline[skip network checks in the doctor step]' \
                        '--deep[run an authenticated probe in the doctor step]' \
                        '(-y --yes)'{-y,--yes}'[unattended: approve all write steps]' \
                        '--non-interactive[unattended contract for scripts/CI]' \
                        '--dry-run[preview write steps; change nothing]' \
                        '--provider=[seed scaffold + diagnose provider]:provider:(xiaomi openai deepseek opencode-go)' \
                        '--model=[diagnose an override model]:model:' \
                        '--api-key=[diagnose an override API key]:key:'
                    ;;

                doctor)
                    _arguments \
                        '--offline[skip network checks]' \
                        '--deep[run an authenticated probe (spends ~1 token)]' \
                        '--probe[live-verify connectivity and credentials for every provider]' \
                        '--selftest[credential-free end-to-end session against a loopback stub]' \
                        '--fix[remediate fixable checks (prompts per fix)]' \
                        '--yes[apply --fix remediations without prompting]' \
                        '--json[stream NDJSON check/fix events + done:true verdict]' \
                        '--report[Markdown diagnostics bundle for bug reports]' \
                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \
                        '--provider=[diagnose an override provider]:provider:(xiaomi openai deepseek opencode-go)' \
                        '--model=[diagnose an override model]:model:' \
                        '--api-key=[diagnose an override API key]:key:'
                    ;;

                bug)
                    _arguments \
                        '--title=[issue title]:title:' \
                        '--body=[description above the bundle]:text:' \
                        '--labels=[issue labels (csv)]:labels:' \
                        '--open[open the issue URL in the system browser]' \
                        '--out=[write the diagnostics bundle to a file]:file:_files' \
                        '--no-report[omit the diagnostics bundle]' \
                        '--offline[skip network checks]' \
                        '--deep[run an authenticated probe (spends ~1 token)]' \
                        '--shell=[completions shell]:shell:(bash zsh fish pwsh all)' \
                        '--provider=[diagnose an override provider]:provider:(xiaomi openai deepseek opencode-go)' \
                        '--model=[diagnose an override model]:model:' \
                        '--api-key=[diagnose an override API key]:key:'
                    ;;

                guide)
                    _arguments '--human[render the guide as markdown]'
                    ;;

                models)
                    # `tau models` takes no further arguments.
                    ;;

                version)
                    _arguments \
                        '--verbose[include build metadata (commit, target, build date, zig version)]' \
                        '--check[non-blocking update check against the latest release]' \
                        '--json[emit the stable {"name","version",...} object]' \
                        '--mode=[output mode]:mode:(text json)'
                    ;;

                upgrade)
                    _arguments \
                        '(-y --yes)'{-y,--yes}'[upgrade without prompting]' \
                        '--dir=[install destination]:dir:_files -/' \
                        '--dry-run[print the resolved plan; install nothing]'
                    ;;

                explain)
                    # Exit codes mirror the stable catalog in src/errors.zig.
                    local -a err_codes=(
                        '1:not_found'
                        '80:invalid_argument'
                        '82:missing_required_field'
                        '105:Timeout'
                        '106:AuthFailed'
                        '110:internal_error'
                        '111:unimplemented'
                    )
                    _arguments \
                        '1: :_describe "error code or type" err_codes' \
                        '--json[emit the stable schema-checked JSON form]' \
                        '--human[render the entry as prose instead of JSON]'
                    ;;
            esac
            ;;
    esac
}

_tau "$@"
